{
  "info": {
    "name": "Starbucks BE - Member Address CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "addressId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"loginId\": \"addressuser01\",\n  \"password\": \"Abcdef1!\"\n}"
        },
        "url": "{{baseUrl}}/api/member/login"
      }
    },
    {
      "name": "2. Create Address",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"addressName\": \"집\",\n  \"recipientName\": \"홍길동\",\n  \"zipcode\": \"06236\",\n  \"baseAddress\": \"서울 강남구 테헤란로 152\",\n  \"detailAddress\": \"101동 1001호\",\n  \"phone1\": \"01077778888\",\n  \"deliveryMemo\": \"문 앞\"\n}"
        },
        "url": "{{baseUrl}}/api/member/addresses"
      }
    },
    {
      "name": "3. List Addresses",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/member/addresses"
      }
    },
    {
      "name": "4. Get Address Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/member/addresses/{{addressId}}"
      }
    },
    {
      "name": "5. Update Address",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"addressName\": \"본사\",\n  \"recipientName\": \"홍길동\",\n  \"zipcode\": \"04524\",\n  \"baseAddress\": \"서울 중구 세종대로 110\",\n  \"detailAddress\": \"21층\",\n  \"phone1\": \"01077778888\",\n  \"isDefault\": true\n}"
        },
        "url": "{{baseUrl}}/api/member/addresses/{{addressId}}"
      }
    },
    {
      "name": "6. Set Default Address",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/member/addresses/{{addressId}}/default"
      }
    },
    {
      "name": "7. Delete Address",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/member/addresses/{{addressId}}"
      }
    }
  ]
}
